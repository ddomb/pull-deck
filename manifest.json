{
  "manifest_version": 3,
  "name": "Pull Deck",
  "version": "1.0.0",
  "description": "See every pull request waiting on you, and open them all into one tab group without ever duplicating a tab.",
  "minimum_chrome_version": "89",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Pull Deck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "permissions": ["tabs", "tabGroups", "storage", "alarms"],
  "host_permissions": ["https://api.github.com/*"]
}
